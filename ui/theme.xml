<Theme Name="RavenIDE" Base="Dark" Accent="#E8794A" CornerRadius="10">
    <Colors
        Window="#000000" Panel="#090909" Input="#111111"
        Text="#F2F2F0" TextDisabled="#8E8E8A" TextPlaceholder="#9B9B97" AccentText="#101010"
        Border="#252525" Control="#151515" ControlHovered="#1D1D1D" ControlPressed="#292927" ControlBorder="#343432"
        Selection="#262626" RowHovered="#171717" Track="#262626" Handle="#737373"
        Separator="#242424" Header="#0A0A0A" HeaderHovered="#1B1B1B" TabActive="#202020"
        Popup="#111111" PopupBorder="#333333" Focus="#E8794A"
        Success="#65C18C" Warning="#E5B567" Danger="#F07575" Link="#E88B5B" Code="#0D0D0D"/>
    <Metrics FontSize="13" ControlHeight="34" RowHeight="36" SplitterSize="3" PaddingX="11" PaddingY="7" Spacing="8"/>
    <Syntax Comment="#8E8E8A" String="#65C18C" Number="#E5B567" Keyword="#E8794A" Type="#E88B5B" Function="#D8D8D4" Heading="#F2F2F0" Strong="#FFFFFF" Link="#E88B5B"/>
    <!-- Buttons: one 30px height everywhere. Default is the secondary action (control fill and border), Primary the one main
         action of a view, Flat only toolbars and icons. "danger" marks destructive actions with the Danger colour. -->
    <Style Widget="Button" CornerRadius="7" ControlHeight="30" PaddingX="12" PaddingY="5"/>
    <Style Widget="Button" Class="danger" Text="#F07575"/>
    <Style Widget="Button" Class="header-action" Control="#00000000" ControlHovered="#191919" ControlPressed="#272727" Text="#C8C8C4"/>
    <Style Widget="Button" Class="send-button" Control="#2B2B2B" ControlHovered="#3A3A3A" ControlPressed="#474747" Text="#F5F5F2" CornerRadius="17"/>
    <Style Widget="HeaderBar" Header="#030303" Text="#F2F2F0"/>
    <Style Widget="Label" Class="section" Text="#92928E" FontSize="11"/>
    <Style Widget="Label" Class="muted" Text="#A3A39F"/>
    <Style Widget="Label" Class="data" Text="#E88B5B" FontSize="11"/>
    <Style Class="surface" Panel="#070707" CornerRadius="0"/>
    <Style Class="workspace" Window="#000000" Panel="#000000" CornerRadius="0"/>
    <Style Class="tabs" Panel="#030303" CornerRadius="0"/>
    <Style Class="tool-header" Panel="#090909" Border="#606060" CornerRadius="10"/>
    <Style Class="composer" Panel="#111111" Border="#303030" CornerRadius="14"/>
    <Style Class="activity" Panel="#0C0C0C" Border="#606060" CornerRadius="14"/>
</Theme>
