<Theme Name="LedgerLight" Base="Light" Accent="#4A5A0D" AccentText="#FFFFFF" CornerRadius="10">
    <Colors
        Window="#F1F0E8" Panel="#E7E7DC" Input="#FFFFFF"
        Text="#171A18" TextDisabled="#566050" TextPlaceholder="#626B58" AccentText="#FFFFFF"
        Border="#A0A894" Control="#E1E4D8" ControlHovered="#D1D8BC" ControlPressed="#C1CCA5" ControlBorder="#89937B"
        Selection="#D4DDB8" RowHovered="#E1E4D8" Track="#C6CDBB" Handle="#68745A"
        Separator="#B4BCA8" Header="#E3E7D7" HeaderHovered="#D1D8BC" TabActive="#D1DAB5"
        Popup="#F8F7F0" PopupBorder="#89937B" Focus="#4A5A0D"
        Success="#3E6B2F" Warning="#8A5B12" Danger="#A33B2B" Link="#1F6F73" Code="#E8E6DC"/>
    <Metrics FontSize="13" ControlHeight="34" RowHeight="36" SplitterSize="3" PaddingX="11" PaddingY="7" Spacing="8"/>
    <Syntax Comment="#566050" String="#3E6B2F" Number="#8A5B12" Keyword="#4A5A0D" Type="#1F6F73" Function="#43512F" Heading="#4A5A0D" Strong="#171A18" Link="#1F6F73"/>
    <!-- Buttons: one 30px height everywhere. Default is the secondary action (control fill and border), Primary the one main
         action of a view, Flat only toolbars and icons. "danger" marks destructive actions with the Danger colour. -->
    <Style Widget="Button" CornerRadius="7" ControlHeight="30" PaddingX="12" PaddingY="5"/>
    <Style Widget="Button" Class="danger" Text="#A33B2B"/>
    <Style Widget="Button" Class="header-action" Control="#00000000" ControlHovered="#D8DDCE" ControlPressed="#C6CFB6" Text="#171A18"/>
    <Style Widget="Button" Class="send-button" Control="#E1E4D8" ControlHovered="#D1D8BC" ControlPressed="#C1CCA5" Text="#171A18" CornerRadius="17"/>
    <Style Widget="HeaderBar" Header="#E9E9E0" Text="#171A18"/>
    <Style Widget="TextEditor" Class="composer-input" Input="#00000000" Border="#00000000" ControlBorder="#00000000"/>
    <Style Widget="Label" Class="section" Text="#4E5947" FontSize="11"/>
    <Style Widget="Label" Class="muted" Text="#4E5846"/>
    <Style Widget="Label" Class="data" Text="#1F6F73" FontSize="11"/>
    <Style Widget="Label" Class="proposal-title" Text="#4A5A0D"/>
    <Style Class="surface" Panel="#E7E7DC" CornerRadius="0"/>
    <Style Class="workspace" Window="#F7F5ED" Panel="#F7F5ED" CornerRadius="0"/>
    <Style Class="tabs" Panel="#E9EBDF" CornerRadius="0"/>
    <Style Class="run-header" Panel="#E8EDDC" Border="#A8B29C" CornerRadius="0"/>
    <Style Class="section-header" Panel="#ECEEE3" Border="#B4BBA8" CornerRadius="0"/>
    <Style Class="tool-header" Panel="#ECEEE3" Border="#7E8B6A" CornerRadius="10"/>
    <Style Class="composer" Panel="#FFFFFF" Border="#A4AF97" CornerRadius="14"/>
    <Style Class="activity" Panel="#F8F8F2" Border="#7E8B6A" CornerRadius="14"/>
    <Style Class="statusbar" Panel="#E2E5D8" Border="#B4BBA8" CornerRadius="0"/>
    <Style Class="proposal" Panel="#E4EBD4" Border="#8A9877" CornerRadius="10"/>
</Theme>
