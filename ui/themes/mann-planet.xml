<Theme Name="MannPlanet" Base="Light" Accent="#276B87" AccentText="#FFFFFF" CornerRadius="10">
    <Colors
        Window="#EAF2F5" Panel="#DCE9EE" Input="#F8FCFD"
        Text="#152831" TextDisabled="#4B6570" TextPlaceholder="#4B6570" AccentText="#FFFFFF"
        Border="#9AB6C2" Control="#D3E4EA" ControlHovered="#BDD8E2" ControlPressed="#A4CAD8" ControlBorder="#749DAD"
        Selection="#B8DCE8" RowHovered="#D3E4EA" Track="#B2CBD4" Handle="#467F96"
        Separator="#B9CDD5" Header="#D5E6EC" HeaderHovered="#BDD8E2" TabActive="#C2DEE8"
        Popup="#F4FAFC" PopupBorder="#749DAD" Focus="#276B87"
        Success="#2F6F5B" Warning="#8A5B18" Danger="#A43E3E" Link="#1F6E8A" Code="#D7E7EC"/>
    <Metrics ScrollbarSize="10" FontSize="13" ControlHeight="34" RowHeight="36" SplitterSize="3" PaddingX="11" PaddingY="7" Spacing="8"/>
    <Syntax Comment="#4B6570" String="#2F6F5B" Number="#8A5B18" Keyword="#276B87" Type="#1F6E8A" Function="#365D6C" Heading="#276B87" Strong="#152831" Link="#1F6E8A"/>
    <!-- Scrollbars stay quiet until hovered: no track, a muted thumb, and the accent only under the pointer. -->
    <Style Widget="ScrollBox" Track="#00000000" Handle="#749DAD" HandleHovered="#467F96"/>
    <Style Widget="ListView" Track="#00000000" Handle="#749DAD" HandleHovered="#467F96"/>
    <Style Widget="TreeView" Track="#00000000" Handle="#749DAD" HandleHovered="#467F96"/>
    <Style Widget="TextEditor" Track="#00000000" Handle="#749DAD" HandleHovered="#467F96"/>
    <Style Widget="FileBrowser" Track="#00000000" Handle="#749DAD" HandleHovered="#467F96"/>
    <!-- Navigation lists sit directly on the sidebar: only rows carry a fill. The transparent fill keeps the panel hue so an unfocused selection blends toward it, not toward black. -->
    <Style Widget="ListView" Class="nav-list" Input="#DCE9EE00"/>
    <!-- Buttons: one 30px height everywhere. Default is the secondary action (control fill and border), Primary the one main
         action of a view, Flat only toolbars and icons. "danger" marks destructive actions with the Danger colour. -->
    <!-- The Files tree sits directly on the workspace surface, with compact rows like a code editor explorer. -->
    <Style Widget="TreeView" Class="file-tree" Input="#F1F7F900" Border="#00000000" ControlBorder="#00000000" Focus="#00000000" RowHeight="26" Indent="14"/>
    <Style Widget="Button" CornerRadius="7" ControlHeight="30" PaddingX="12" PaddingY="5"/>
    <Style Widget="Button" Class="danger" Text="#A43E3E"/>
    <Style Widget="Button" Class="header-action" Control="#00000000" ControlHovered="#D3E4EA" ControlPressed="#BDD8E2" Text="#152831"/>
    <Style Widget="Button" Class="send-button" Control="#D3E4EA" ControlHovered="#BDD8E2" ControlPressed="#A4CAD8" Text="#152831" CornerRadius="17"/>
    <Style Widget="HeaderBar" Header="#E4EFF3" Text="#152831"/>
    <Style Widget="TextEditor" Class="composer-input" Input="#00000000" Border="#00000000" ControlBorder="#00000000" RowHovered="#00000000"/>
    <Style Widget="Label" Class="section" Text="#4B6570" FontSize="11"/>
    <Style Widget="Label" Class="muted" Text="#4B6570"/>
    <Style Widget="Label" Class="data" Text="#1F6E8A" FontSize="11"/>
    <Style Widget="Label" Class="proposal-title" Text="#276B87"/>
    <Style Class="surface" Panel="#DCE9EE" CornerRadius="0"/>
    <Style Class="workspace" Window="#F1F7F9" Panel="#F1F7F9" CornerRadius="0"/>
    <Style Class="tabs" Panel="#E1EDF1" CornerRadius="0"/>
    <Style Class="run-header" Panel="#E2EEF2" Border="#ACC3CD" CornerRadius="0"/>
    <Style Class="section-header" Panel="#E7F0F3" Border="#B9CDD5" CornerRadius="0"/>
    <Style Class="tool-header" Panel="#00000000" Border="#00000000" CornerRadius="10"/>
    <Style Class="composer" Panel="#F8FCFD" Border="#9AB6C2" CornerRadius="14"/>
    <Style Class="activity" Panel="#F4FAFC" Border="#648A9B" CornerRadius="14"/>
    <Style Class="statusbar" Panel="#D5E4EA" Border="#B9CDD5" CornerRadius="0"/>
    <Style Class="proposal" Panel="#DCECF1" Border="#8DAEBC" CornerRadius="10"/>
</Theme>
