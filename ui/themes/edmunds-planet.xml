<Theme Name="EdmundsPlanet" Base="Light" Accent="#8A4F2A" AccentText="#FFFFFF" CornerRadius="10">
    <Colors
        Window="#F3E9D8" Panel="#E8DAC3" Input="#FFF9EE"
        Text="#30251B" TextDisabled="#67523F" TextPlaceholder="#67523F" AccentText="#FFFFFF"
        Border="#B99D7D" Control="#E4D2B7" ControlHovered="#DAC09E" ControlPressed="#CEAC82" ControlBorder="#A38260"
        Selection="#E2C29C" RowHovered="#E4D2B7" Track="#CBB596" Handle="#98613C"
        Separator="#CDB99D" Header="#E6D4B8" HeaderHovered="#DAC09E" TabActive="#E0C29D"
        Popup="#FFF8EC" PopupBorder="#A38260" Focus="#8A4F2A"
        Success="#4E6D45" Warning="#925F22" Danger="#A54532" Link="#346C72" Code="#E9DCC8"/>
    <Metrics ScrollbarSize="10" FontSize="13" ControlHeight="34" RowHeight="36" SplitterSize="3" PaddingX="11" PaddingY="7" Spacing="8"/>
    <Syntax Comment="#67523F" String="#4E6D45" Number="#925F22" Keyword="#8A4F2A" Type="#346C72" Function="#765136" Heading="#8A4F2A" Strong="#30251B" Link="#346C72"/>
    <!-- Scrollbars stay quiet until hovered: no track, a muted thumb, and the accent only under the pointer. -->
    <Style Widget="ScrollBox" Track="#00000000" Handle="#A38260" HandleHovered="#98613C"/>
    <Style Widget="ListView" Track="#00000000" Handle="#A38260" HandleHovered="#98613C"/>
    <Style Widget="TreeView" Track="#00000000" Handle="#A38260" HandleHovered="#98613C"/>
    <Style Widget="TextEditor" Track="#00000000" Handle="#A38260" HandleHovered="#98613C"/>
    <Style Widget="FileBrowser" Track="#00000000" Handle="#A38260" HandleHovered="#98613C"/>
    <!-- Navigation lists sit directly on the sidebar: only rows carry a fill. The transparent fill keeps the panel hue so an unfocused selection blends toward it, not toward black. -->
    <Style Widget="ListView" Class="nav-list" Input="#E8DAC300"/>
    <Style Widget="Button" CornerRadius="8"/>
    <Style Widget="Button" Class="header-action" Control="#00000000" ControlHovered="#E4D2B7" ControlPressed="#DAC09E" Text="#30251B"/>
    <Style Widget="Button" Class="send-button" Control="#E4D2B7" ControlHovered="#DAC09E" ControlPressed="#CEAC82" Text="#30251B" CornerRadius="17"/>
    <Style Widget="HeaderBar" Header="#F4EADA" Text="#30251B"/>
    <Style Widget="TextEditor" Class="composer-input" Input="#00000000" Border="#00000000" ControlBorder="#00000000" RowHovered="#00000000"/>
    <Style Widget="Label" Class="section" Text="#6C5845" FontSize="11"/>
    <Style Widget="Label" Class="muted" Text="#6C5845"/>
    <Style Widget="Label" Class="data" Text="#346C72" FontSize="11"/>
    <Style Widget="Label" Class="proposal-title" Text="#8A4F2A"/>
    <Style Class="surface" Panel="#E8DAC3" CornerRadius="0"/>
    <Style Class="workspace" Window="#F8F0E3" Panel="#F8F0E3" CornerRadius="0"/>
    <Style Class="tabs" Panel="#EEE2CF" CornerRadius="0"/>
    <Style Class="run-header" Panel="#F0E3CE" Border="#CDB99D" CornerRadius="0"/>
    <Style Class="section-header" Panel="#F1E6D4" Border="#CDB99D" CornerRadius="0"/>
    <Style Class="tool-header" Panel="#F1E6D4" Border="#9A7652" CornerRadius="10"/>
    <Style Class="composer" Panel="#FFF9EE" Border="#B99D7D" CornerRadius="14"/>
    <Style Class="activity" Panel="#FFF8EC" Border="#9A7652" CornerRadius="14"/>
    <Style Class="statusbar" Panel="#E6D7C0" Border="#CDB99D" CornerRadius="0"/>
    <Style Class="proposal" Panel="#F1DFC2" Border="#B3926D" CornerRadius="10"/>
</Theme>
