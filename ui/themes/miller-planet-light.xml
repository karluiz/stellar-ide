<Theme Name="MillerPlanetLight" Base="Light" Accent="#0C6070" AccentText="#FFFFFF" CornerRadius="10">
    <Colors
        Window="#E8F4F6" Panel="#D5E8ED" Input="#F6FCFD"
        Text="#102830" TextDisabled="#48636B" TextPlaceholder="#4E6A72" AccentText="#FFFFFF"
        Border="#7EA6B2" Control="#C3DEE6" ControlHovered="#ADD2DE" ControlPressed="#91C1D0" ControlBorder="#648F9E"
        Selection="#B2D8E3" RowHovered="#C3DEE6" Track="#AAC9D3" Handle="#467F96"
        Separator="#AAC4CE" Header="#D5E6EC" HeaderHovered="#ADD2DE" TabActive="#B9DBE5"
        Popup="#F4FAFC" PopupBorder="#648F9E" Focus="#0C6070"
        Success="#2F6F5B" Warning="#8A5B18" Danger="#A43E3E" Link="#0C6070" Code="#D7E7EC"/>
    <Metrics ScrollbarSize="10" FontSize="13" ControlHeight="34" RowHeight="36" SplitterSize="3" PaddingX="11" PaddingY="7" Spacing="8"/>
    <Syntax Comment="#48636B" String="#2F6F5B" Number="#8A5B18" Keyword="#0C6070" Type="#0C6070" Function="#365D6C" Heading="#0C6070" Strong="#102830" Link="#0C6070"/>
    <!-- Scrollbars stay quiet until hovered: no track, a muted thumb, and the accent only under the pointer. -->
    <Style Widget="ScrollBox" Track="#00000000" Handle="#648F9E" HandleHovered="#467F96"/>
    <Style Widget="ListView" Track="#00000000" Handle="#648F9E" HandleHovered="#467F96"/>
    <Style Widget="TreeView" Track="#00000000" Handle="#648F9E" HandleHovered="#467F96"/>
    <Style Widget="TextEditor" Track="#00000000" Handle="#648F9E" HandleHovered="#467F96"/>
    <Style Widget="FileBrowser" Track="#00000000" Handle="#648F9E" HandleHovered="#467F96"/>
    <!-- Navigation lists sit directly on the sidebar: only rows carry a fill. The transparent fill keeps the panel hue so an unfocused selection blends toward it, not toward black. -->
    <Style Widget="ListView" Class="nav-list" Input="#D5E8ED00"/>
    <!-- Buttons: one 30px height everywhere. Default is the secondary action (control fill and border), Primary the one main
         action of a view, Flat only toolbars and icons. "danger" marks destructive actions with the Danger colour. -->
    <!-- The Files tree sits directly on the workspace surface, with compact rows like a code editor explorer. -->
    <Style Widget="TreeView" Class="file-tree" Input="#F1F7F900" Border="#00000000" ControlBorder="#00000000" Focus="#00000000" RowHeight="26" Indent="14"/>
    <Style Widget="Button" CornerRadius="7" ControlHeight="30" PaddingX="12" PaddingY="5"/>
    <Style Widget="Button" Class="danger" Text="#A43E3E"/>
    <Style Widget="Button" Class="header-action" Control="#00000000" ControlHovered="#C3DEE6" ControlPressed="#ADD2DE" Text="#102830"/>
    <Style Widget="Button" Class="send-button" Control="#C3DEE6" ControlHovered="#ADD2DE" ControlPressed="#91C1D0" Text="#102830" CornerRadius="17"/>
    <Style Widget="HeaderBar" Header="#E4F0F3" Text="#102830"/>
    <Style Widget="TextEditor" Class="composer-input" Input="#00000000" Border="#00000000" ControlBorder="#00000000" RowHovered="#00000000"/>
    <Style Widget="Label" Class="section" Text="#48636B" FontSize="11"/>
    <Style Widget="Label" Class="muted" Text="#48636B"/>
    <Style Widget="Label" Class="data" Text="#0C6070" FontSize="11"/>
    <Style Widget="Label" Class="proposal-title" Text="#0C6070"/>
    <Style Class="surface" Panel="#D5E8ED" CornerRadius="0"/>
    <Style Class="workspace" Window="#F1F7F9" Panel="#F1F7F9" CornerRadius="0"/>
    <Style Class="tabs" Panel="#E1EDF1" CornerRadius="0"/>
    <Style Class="run-header" Panel="#E2EEF2" Border="#AAC4CE" CornerRadius="0"/>
    <Style Class="section-header" Panel="#E7F0F3" Border="#AAC4CE" CornerRadius="0"/>
    <Style Class="tool-header" Panel="#E7F0F3" Border="#4C8290" CornerRadius="10"/>
    <Style Class="composer" Panel="#F6FCFD" Border="#7EA6B2" CornerRadius="14"/>
    <Style Class="activity" Panel="#F4FAFC" Border="#4C8290" CornerRadius="14"/>
    <Style Class="statusbar" Panel="#D5E4EA" Border="#AAC4CE" CornerRadius="0"/>
    <Style Class="proposal" Panel="#DCECF1" Border="#648F9E" CornerRadius="10"/>
</Theme>
