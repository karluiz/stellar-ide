<Theme Name="Gargantua" Base="Dark" Accent="#F2B35D" AccentText="#211408" CornerRadius="10">
    <Colors
        Window="#0D0C0B" Panel="#17140F" Input="#211C14"
        Text="#F3EDE2" TextDisabled="#A79C8C" TextPlaceholder="#B4A794" AccentText="#211408"
        Border="#51432F" Control="#292117" ControlHovered="#3A2D1D" ControlPressed="#4D3A22" ControlBorder="#6A5232"
        Selection="#5B421F" RowHovered="#3A2D1D" Track="#3D3122" Handle="#D7A157"
        Separator="#51432F" Header="#1E1811" HeaderHovered="#3A2D1D" TabActive="#443219"
        Popup="#1C1711" PopupBorder="#6A5232" Focus="#F2B35D"
        Success="#B8D788" Warning="#F2B35D" Danger="#FF8E72" Link="#E8C78E" Code="#18130E"/>
    <Metrics ScrollbarSize="10" FontSize="13" ControlHeight="30" RowHeight="36" SplitterSize="3" PaddingX="11" PaddingY="5" Spacing="8"/>
    <Syntax Comment="#A79C8C" String="#B8D788" Number="#F2B35D" Keyword="#F2B35D" Type="#E8C78E" Function="#D8C7AB" Heading="#F2B35D" Strong="#FFF7E9" Link="#E8C78E"/>
    <!-- Scrollbars stay quiet until hovered: no track, a muted thumb, and the accent only under the pointer. -->
    <Style Widget="ScrollBox" Track="#00000000" Handle="#6A5232" HandleHovered="#D7A157"/>
    <Style Widget="ListView" Track="#00000000" Handle="#6A5232" HandleHovered="#D7A157"/>
    <Style Widget="TreeView" Track="#00000000" Handle="#6A5232" HandleHovered="#D7A157"/>
    <Style Widget="TextEditor" Track="#00000000" Handle="#6A5232" HandleHovered="#D7A157"/>
    <Style Widget="FileBrowser" Track="#00000000" Handle="#6A5232" HandleHovered="#D7A157"/>
    <!-- Navigation lists sit directly on the sidebar: only rows carry a fill. The transparent fill keeps the panel hue so an unfocused selection blends toward it, not toward black. -->
    <Style Widget="ListView" Class="nav-list" Input="#17140F00"/>
    <!-- Buttons share the 30px ControlHeight of every input and combo box. Default is the secondary action (control fill and border), Primary the one main
         action of a view, Flat only toolbars and icons. "danger" marks destructive actions with the Danger colour. -->
    <!-- The Files tree sits directly on the workspace surface, with compact rows like a code editor explorer. -->
    <Style Widget="TreeView" Class="file-tree" Input="#100E0C00" Border="#00000000" ControlBorder="#00000000" Focus="#00000000" RowHeight="26" Indent="14"/>
    <Style Widget="Button" CornerRadius="7" PaddingX="12"/>
    <Style Widget="Button" Class="danger" Text="#FF8E72"/>
    <Style Widget="Button" Class="header-action" Control="#00000000" ControlHovered="#292117" ControlPressed="#3A2D1D" Text="#F3EDE2"/>
    <Style Widget="Button" Class="send-button" Control="#292117" ControlHovered="#3A2D1D" ControlPressed="#4D3A22" Text="#F3EDE2" CornerRadius="17"/>
    <Style Widget="HeaderBar" Header="#100E0C" Text="#F3EDE2"/>
    <Style Widget="TextEditor" Class="composer-input" Input="#00000000" Border="#00000000" ControlBorder="#00000000" RowHovered="#00000000"/>
    <Style Widget="Label" Class="section" Text="#B4A794" FontSize="11"/>
    <Style Widget="Label" Class="muted" Text="#B4A794"/>
    <Style Widget="Label" Class="data" Text="#E8C78E" FontSize="11"/>
    <Style Widget="Label" Class="proposal-title" Text="#F2B35D"/>
    <Style Class="surface" Panel="#17140F" CornerRadius="0"/>
    <Style Class="workspace" Window="#100E0C" Panel="#100E0C" CornerRadius="0"/>
    <!-- Tabs are text with an accent underline on one divider line: no strip or active fill. -->
    <Style Class="tabs" Panel="#14110D" Header="#00000000" TabActive="#00000000" CornerRadius="0"/>
    <Style Class="run-header" Panel="#1E1811" Border="#51432F" CornerRadius="0"/>
    <Style Class="section-header" Panel="#1D1812" Border="#51432F" CornerRadius="0"/>
    <Style Class="tool-header" Panel="#00000000" Border="#00000000" CornerRadius="10"/>
    <Style Class="composer" Panel="#211C14" Border="#8A6536" CornerRadius="14"/>
    <Style Class="activity" Panel="#1D1812" Border="#8A6536" CornerRadius="14"/>
    <Style Class="statusbar" Panel="#0A0908" Border="#51432F" CornerRadius="0"/>
    <Style Class="proposal" Panel="#3B2B15" Border="#8A6536" CornerRadius="10"/>
</Theme>
