    <Style Widget="Button" CornerRadius="8"/>
    <Style Widget="Button" Class="header-action" Control="#00000000" ControlHovered="#C8E2D5" ControlPressed="#B1D5C4" Text="#15352B"/>
    <Style Widget="Button" Class="send-button" Control="#C8E2D5" ControlHovered="#B1D5C4" ControlPressed="#94C4AE" Text="#15352B" CornerRadius="17"/>
